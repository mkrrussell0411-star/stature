:: StoryStylesheet [stylesheet]
body {
  font-family: Georgia, "Times New Roman", serif;
  max-width: 42rem;
  margin: 2rem auto;
  line-height: 1.5;
}

.age-gate {
  border: 1px solid #ccc;
  padding: 1.5rem;
  border-radius: 8px;
}

button {
  margin: 0.25rem 0.5rem 0.25rem 0;
}

.stature-scene-host,
.scrub-svg {
  margin: 1rem 0;
  max-width: 100%;
  overflow-x: auto;
}

.error {
  border: 1px solid #c00;
  padding: 0.5rem;
  margin: 0.5rem 0;
}
