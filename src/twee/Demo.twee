:: Demo
<<if not $ageVerified>>
  <<goto "AgeGate">>
<</if>>

<div id="stature-scene-panel" class="stature-scene-host"></div>

<h2>Engine demo</h2>
<p><<do tag "size">><<print setup.engine.text.renderFocusLine()>><</do>></p>
<p>Templates: ?h · ?size-word · ?eye-ref</p>
<p>Jules: <<sz "jules" "eye">></p>

<<set _d to setup.engine.derive($focus)>>
<p>Stage: <<print _d.stages.scale>> · Scale ×<<print _d.scale>></p>

<<button "Gentle (+5 cm)">>
  <<run setup.engine.apply($focus, { height_cm: 5 }, "demo-growth")>>
  <<refreshScene>>
  <<redo "size">>
<</button>>
<<button "Surge (+40 cm)">>
  <<run setup.engine.apply($focus, { height_cm: 40 }, "demo-surge")>>
  <<refreshScene>>
  <<redo "size">>
<</button>>

<h3>Pacing dial</h3>
<<button "Gentle pacing">>
  <<run setup.engine.applyPacing($focus, "gentle")>>
<</button>>
<<button "Steady pacing">>
  <<run setup.engine.applyPacing($focus, "steady")>>
<</button>>
<<button "Surge pacing">>
  <<run setup.engine.applyPacing($focus, "surge")>>
<</button>>
<<button "Tick growth">>
  <<run setup.engine.tickGrowth($focus, 1, "linear")>>
  <<refreshScene>>
  <<redo "size">>
<</button>>

<h3>Threshold deck</h3>
<<set _events to setup.engine.drainEventQueue()>>
<<if _events.length gt 0>>
  <<for _e range _events>>
    <p class="threshold-event">Threshold: <<print _e.cardId>> (<<print _e.charId>>)</p>
  <</for>>
<</if>>
<<set _card to setup.engine.drawStorylet()>>
<<if _card>>
  <<set $lastCard to _card.prose>>
  <blockquote><<print $lastCard>></blockquote>
  <<run setup.cardsPlayed.add(_card.id)>>
<</if>>

<h3>Timeline scrubber</h3>
<p>Ledger replay (read-only). Index <<print $scrubIndex>> (use −1 for live state).</p>
<<textbox "$scrubIndex" $scrubIndex autofocus false>>
<<button "Scrub">>
  <<refreshScene>>
<</button>>
<<set _svg to setup.engine.sceneSvgForScrub($onStage, $scrubIndex)>>
<div class="scrub-svg"><<= _svg>></div>

<p>[[Settings|Settings]] · [[Replay age gate|AgeGate]]</p>
